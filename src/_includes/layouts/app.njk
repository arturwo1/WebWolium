<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {# ---- defaults ---- #}
  {% set siteName = "Wolium" %}
  {% set siteUrl = "https://Wolium.netlify.app" %}
  {% set siteDesc = "Track your Discord server activity with charts, profiles, leaderboards and economy. Free bot, no corporate tone." %}
  {% set siteKeywords = "Wolium, arturwol, bot, discord" %}
  {% set siteAuthor = "arturwol" %}
  {% set siteLocale = "en_US" %}
  {% set siteTheme = "#23272a" %}
  {% set siteIcon = "/images/Wolium.webp" %}
  {% set siteTwitter = "@artnrwol" %}

  {% set pageTitle = siteName %}
  {% if title %}
    {% set pageTitle = "Wolium | " ~ title %}
  {% else %}
    {% set pageTitle = Wolium %}
  {% endif %}

  {% set pageDesc = description or excerpt or siteDesc %}

  {% set pagePath = "/" %}
  {% if page and page.url %}
    {% set pagePath = page.url %}
  {% endif %}

  {% set pageUrl = canonical or (siteUrl ~ pagePath) %}

  {# ---- OG/Twitter defaults ---- #}
  {% set defaultOgImg = og_default_image or (siteUrl ~ siteIcon) %}
  {% set ogImg = og_image or twitter_image or defaultOgImg %}
  {% set ogAlt = og_image_alt or "Wolium preview image" %}
  {% set twAlt = twitter_image_alt or ogAlt %}

  <!-- Basic -->
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="keywords" content="{{ keywords or siteKeywords }}">
  <meta name="author" content="{{ author or siteAuthor }}">
  <meta name="robots" content="{{ robots or (noindex and 'noindex,nofollow' or 'index,follow') }}">
  <meta name="theme-color" content="{{ theme_color or siteTheme }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Apple -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="{{ apple_title or pageTitle }}">

  <!-- Microsoft -->
  <meta name="msapplication-TileColor" content="{{ ms_tile_color or (theme_color or siteTheme) }}">
  <meta name="msapplication-TileImage" content="{{ ms_tile_image or siteIcon }}">

  <!-- Open Graph / Facebook / Discord / LinkedIn -->
  <meta property="og:title" content="{{ og_title or pageTitle }}">
  <meta property="og:description" content="{{ og_description or pageDesc }}">
  <meta property="og:type" content="{{ og_type or "website" }}">
  <meta property="og:url" content="{{ og_url or pageUrl }}">
  <meta property="og:image" content="{{ ogImg }}" data-dyn-og>
  <meta property="og:image:alt" content="{{ ogAlt }}">
  <meta property="og:site_name" content="{{ og_site_name or pageTitle }}">
  <meta property="og:locale" content="{{ og_locale or siteLocale }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="{{ twitter_card or "summary_large_image" }}">
  <meta name="twitter:title" content="{{ twitter_title or pageTitle }}">
  <meta name="twitter:description" content="{{ twitter_description or pageDesc }}">
  <meta name="twitter:image" content="{{ twitter_image or ogImg }}" data-dyn-tw>
  <meta name="twitter:image:alt" content="{{ twAlt }}">
  <meta name="twitter:site" content="{{ twitter_site or siteTwitter }}">

  <!-- TransitionControl -->
  <script>
    (() => {
      const KEY = "wolium:page-transition";
      const doc = document.documentElement;

      let data = null;

      try {
        data = JSON.parse(sessionStorage.getItem(KEY) || "null");
      } catch {
        data = null;
      }

      const navEntries = performance.getEntriesByType?.("navigation");
      const navType = navEntries?.[0]?.type || "navigate";

      if (data?.mode === "internal-link") {
        doc.classList.add("pt-enter-main");
        sessionStorage.removeItem(KEY);
        return;
      }

      if (navType === "reload") {
        doc.classList.add("pt-enter-shell");
        return;
      }

      if (navType === "back_forward") {
        doc.classList.add("pt-enter-main");
        return;
      }

      doc.classList.add("pt-enter-shell");
    })();
  </script>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NL5JFYRXCQ"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    window.gtag = gtag;
    window.gtag('consent', 'default', {
      ad_storage: 'denied',
      analytics_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
    window.gtag('js', new Date());
  </script>

  <!-- Google AdSense -->
  <meta name="google-adsense-account" content="ca-pub-5853668593158059">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5853668593158059" crossorigin="anonymous"></script>

  <!-- Main -->
  <link rel="stylesheet" href="/assets/style.css">
  <script type="module" src="/assets/app.js"></script>
</head>

<body data-page="{{ pageId or '' }}">
  {{ icons | safe }}

  {% include "partials/gate.njk" %}

  <div class="app" id="appShell" hidden>
    {% include "partials/topbar.njk" %}
    {% include "partials/sidebar.njk" %}

    <main class="main" id="pageRoot">
      <div class="page-content" id="pageContent">
        {{ content | safe }}
      </div>
    </main>

    <div class="overlay" id="overlay"></div>
  </div>

  {% include "partials/modals.njk" %}
</body>
</html>