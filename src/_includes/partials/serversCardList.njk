{% macro renderServersDemo(data) %}
<div class="card section srv-head">
  <div class="srv-head__main">
    <div class="section-title" data-i18n="servers.title">Your Discord servers</div>
    <div class="srv-head__text" data-i18n="servers.subtitle">Select a server to open analytics, settings and Wolium configuration.</div>
  </div>

  <div class="stats srv-head__stats">
    <div class="stat card-hover">
      <div class="stat__label" data-i18n="servers.stat_all">Servers</div>
      <div class="stat__value" data-field="stat-all">{{ data.stats.all }}</div>
    </div>
    <div class="stat card-hover">
      <div class="stat__label" data-i18n="servers.stat_full">Full access</div>
      <div class="stat__value" data-field="stat-full">{{ data.stats.full }}</div>
    </div>
    <div class="stat card-hover">
      <div class="stat__label" data-i18n="servers.stat_manage">Manageable</div>
      <div class="stat__value" data-field="stat-manage">{{ data.stats.manage }}</div>
    </div>
    <div class="stat card-hover">
      <div class="stat__label" data-i18n="servers.stat_mod">Moderation</div>
      <div class="stat__value" data-field="stat-mod">{{ data.stats.mod }}</div>
    </div>
  </div>
</div>

<div class="card section srv-toolbar">
  <input class="input--sm srv-search" data-field="search" type="search" autocomplete="off" data-i18n-attr="placeholder: servers.search_placeholder" placeholder="Search servers...">

  <div class="srv-tabs">
    <button class="srv-tab is-active" type="button" data-srv-filter="all" data-field="filter" aria-pressed="true" data-i18n="servers.filter_all">All</button>
    <button class="srv-tab" type="button" data-srv-filter="full" data-field="filter" aria-pressed="false" data-i18n="servers.filter_full">Full access</button>
    <button class="srv-tab" type="button" data-srv-filter="manage" data-field="filter" aria-pressed="false" data-i18n="servers.filter_manage">Management</button>
    <button class="srv-tab" type="button" data-srv-filter="mod" data-field="filter" aria-pressed="false" data-i18n="servers.filter_mod">Moderation</button>
    <button class="srv-tab" type="button" data-srv-filter="member" data-field="filter" aria-pressed="false" data-i18n="servers.filter_member">Member</button>
  </div>
</div>

<div class="srv-list" data-field="list">
  {% for guild in data.guilds %}
  <div class="srv-card card card-hover" data-power="{{ guild.power.id }}">
    <div class="srv-card__icon">
      <img class="srv-card__img" src="{{ guild.iconUrl }}" alt="" loading="lazy" width="64" height="64">
    </div>
    <div class="srv-card__body">
      <div class="srv-card__top">
        <span class="srv-card__name text-truncate">{{ guild.name }}</span>
        <span class="srv-level srv-level--{{ guild.power.id }}" data-i18n="{{ guild.power.labelKey }}">{{ guild.power.label }}</span>
      </div>
      <p class="srv-card__hint text-truncate" data-i18n="{{ guild.power.hintKey }}">{{ guild.power.hint }}</p>
      <div class="srv-card__badges">
        {% for badge in guild.badges %}
        <span class="srv-badge srv-badge--{{ badge.tone }}" data-i18n="{{ badge.key }}">{{ badge.label }}</span>
        {% endfor %}
      </div>
    </div>
    <span class="srv-card__arrow" aria-hidden="true">
      <svg class="icon" width="18" height="18" aria-hidden="true"><use href="#right"></use></svg>
    </span>
  </div>
  {% endfor %}
</div>
{% endmacro %}