{% import "partials/home/leaf.njk" as leafRenderer %}

{% macro i18nKey(section, audience, fullPath, field) %}{{ fullPath | i18nKeyFilter(section, audience, field) }}{% endmacro %}

{% macro renderNode(node, section, audience, idPath, addHoverClass, skipFlyWrap, forceStatic) %}
  {% if audience in node.audience %}
  {% set fullPath = idPath | concat(node.id) %}
  {% set nodeKeyBase = "home." + section + "." + audience + "." + (fullPath | join(".")) %}
  {% set titleKey = nodeKeyBase + ".title" %}

  {% if node.display == "leaf" %}
    {{ leafRenderer.renderLeaf(node, section, audience, fullPath, addHoverClass, skipFlyWrap, forceStatic) }}

  {% elif node.display == "carousel" %}
    <div class="home-node home-carousel" data-node-id="{{ node.id }}" data-node-display="carousel"
      {% if node.meta.infinite %}data-carousel-infinite{% endif %}>
      {% if node.title %}
        <div class="fly-anchor"><div class="fly-reveal"><div class="fly-inner fly-frame fly-frame--tight">
          <div class="home-node__title" data-i18n="{{ titleKey }}">{{ titleKey | t }}</div>
        </div></div></div>
      {% endif %}
      <div class="home-carousel__track" data-carousel-track>
        {% for child in node.children %}
          {% if audience in child.audience %}
          <div class="home-carousel__slide" data-carousel-slide>
            {{ renderNode(child, section, audience, fullPath, false, false, false) }}
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  {% elif node.display == "accordion" %}
    <div class="home-node home-accordion" data-node-id="{{ node.id }}" data-node-display="accordion">
      {% if node.title %}
        <div class="fly-anchor"><div class="fly-reveal"><div class="fly-inner fly-frame fly-frame--tight">
          <div class="home-node__title" data-i18n="{{ titleKey }}">{{ titleKey | t }}</div>
        </div></div></div>
      {% endif %}
      {% for child in node.children %}
        {% if audience in child.audience %}
        {% set childTeaserKey = i18nKey(section, audience, fullPath | concat(child.id), 'teaser') %}
        <div class="fly-anchor"><div class="fly-reveal"><div class="fly-inner{% if forceStatic %} fly-inner--static{% endif %}">
          <div class="home-accordion__item" data-accordion-item>
            <button type="button" class="home-accordion__trigger" data-accordion-trigger aria-expanded="false">
              <span class="home-accordion__label" data-i18n="{{ childTeaserKey }}">{{ childTeaserKey | t }}</span>
              <span class="home-accordion__chevron" aria-hidden="true">
                <svg class="icon home-accordion__chevron-down"><use href="#down"></use></svg>
                <svg class="icon home-accordion__chevron-up"><use href="#top"></use></svg>
              </span>
            </button>
            <div class="home-accordion__panel" data-accordion-panel hidden>
              {{ renderNode(child, section, audience, fullPath, false, true, forceStatic) }}
            </div>
          </div>
        </div></div></div>
        {% endif %}
      {% endfor %}
    </div>

  {% elif node.display == "grid" %}
    <div class="home-node home-grid" data-node-id="{{ node.id }}" data-node-display="grid">
      {% if node.title %}
        <div class="fly-anchor"><div class="fly-reveal"><div class="fly-inner fly-frame fly-frame--tight">
          <div class="home-node__title" data-i18n="{{ titleKey }}">{{ titleKey | t }}</div>
        </div></div></div>
      {% endif %}
      <div class="home-grid__cells">
        {% for child in node.children %}
          {% if audience in child.audience %}
          <div class="home-grid__cell">
            {{ renderNode(child, section, audience, fullPath, true, false, forceStatic) }}
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  {% elif node.display == "tabs" %}
    <div class="home-node home-node-tabs" data-node-id="{{ node.id }}" data-node-display="tabs">
      <div class="home-node-tabs__bar" data-node-tabs-bar>
        {% for child in node.children %}
          {% if audience in child.audience %}
          {% set childTeaserKey = i18nKey(section, audience, fullPath | concat(child.id), 'teaser') %}
          <button type="button" class="home-node-tabs__btn{% if loop.first %} is-active{% endif %}" data-node-tabs-btn data-target="{{ child.id }}">
            <span data-i18n="{{ childTeaserKey }}">{{ childTeaserKey | t }}</span>
          </button>
          {% endif %}
        {% endfor %}
      </div>
      <div class="home-slide-track" data-node-tabs-track>
        {% for child in node.children %}
          {% if audience in child.audience %}
          <div class="home-node-tabs__panel{% if loop.first %} is-active{% endif %}" data-node-tabs-panel="{{ child.id }}">
            {{ renderNode(child, section, audience, fullPath, false, false, forceStatic) }}
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  {% elif node.display == "bento" %}
    <div class="home-node home-bento" data-node-id="{{ node.id }}" data-node-display="bento">
      {% if node.title %}
        <div class="fly-anchor"><div class="fly-reveal"><div class="fly-inner fly-frame fly-frame--tight">
          <div class="home-node__title" data-i18n="{{ titleKey }}">{{ titleKey | t }}</div>
        </div></div></div>
      {% endif %}
      <div class="home-bento__cells">
        {% for child in node.children %}
          {% if audience in child.audience %}
          <div class="home-bento__cell" data-bento-size="{{ child.meta.bentoSize | default('1x1') }}">
            {{ renderNode(child, section, audience, fullPath, false, false, forceStatic) }}
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  {% elif node.display == "timeline" %}
    <div class="home-node home-timeline" data-node-id="{{ node.id }}" data-node-display="timeline">
      {% if node.title %}
        <div class="fly-anchor"><div class="fly-reveal"><div class="fly-inner fly-frame fly-frame--tight">
          <div class="home-node__title" data-i18n="{{ titleKey }}">{{ titleKey | t }}</div>
        </div></div></div>
      {% endif %}
      <div class="home-timeline__track">
        {% for child in node.children %}
          {% if audience in child.audience %}
          <div class="home-timeline__step">
            <div class="home-timeline__dot" aria-hidden="true"></div>
            <div class="home-timeline__content">
              {{ renderNode(child, section, audience, fullPath, false, false, forceStatic) }}
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  {% else %}
    <div class="home-node home-node--unknown-display"></div>
  {% endif %}
  {% endif %}
{% endmacro %}
