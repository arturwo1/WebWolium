<header class="topbar">
  <button class="icon-btn mobile-only" id="btnMenu" aria-label="Menu" data-i18n-attr="aria-label: common.menu">
    <svg class="icon">
      <use href="#menu"></use>
    </svg>
  </button>

  <div class="server-switch" id="serverSwitch" aria-hidden="true">
    <button class="pill" id="serverPill" type="button">
      <span class="dot"></span>
      <span id="serverName" data-i18n="server.name">Server didn’t choose</span>
      <span class="chev">▾</span>
    </button>

    <div class="dropdown" id="serverDropdown" role="menu">
      <button class="dd-item" data-server="AstroCommunity" type="button">AstroCommunity</button>
      <button class="dd-item" data-server="NightRaid" type="button">NightRaid</button>
      <button class="dd-item" data-server="WoliumTest" type="button">WoliumTest</button>
    </div>
  </div>

  <div class="spacer"></div>

  <form id="userSearch">
    <input type="search" class="input input--sm" id="searchUser" placeholder="Enter nickname or user ID" data-i18n-attr="placeholder: search.user"/>
    <button type="submit" style="display: none;" data-i18n="enter">Enter</button>
  </form>

  <button class="pill" id="btnLogin" type="button" data-i18n="login.discord">Log In with Discord</button>

  <div class="user loading" id="userBox" hidden>
    <button class="avatar skeleton" id="btnAvatar" type="button" aria-haspopup="menu" aria-expanded="false">
      <img alt="User avatar" id="userAvatarImg" src="https://cdn.discordapp.com/embed/avatars/0.png" data-i18n-attr="alt: profile.avatar_alt" />
    </button>

    <div class="dropdown dropdown--right" id="userDropdown" role="menu">
      <a class="dd-item" href="/profile/" data-i18n="page.title.profile">Profile</a>
      <a class="dd-item" href="/settings/" data-i18n="page.title.settings">Settings</a>
      <div class="dd-sep"></div>
      <button class="dd-item dd-item--danger" data-action="logout" type="button" data-i18n="logout">Log Out</button>
    </div>
  </div>
</header>
