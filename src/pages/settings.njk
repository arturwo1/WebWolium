---
layout: app.njk
title: Wolium | Settings
pageId: settings
permalink: /settings/
noindex: true
---

<h1 class="h1" data-i18n="settings">Settings</h1>

<article class="card section">
  <h2 class="section-title" data-i18n="settings.display">Display</h2>

  <div class="kv" style="gap:10px">
    <label class="k" for="lang" data-i18n="language">Language</label>
    <select class="input" id="lang" data-lang-select>
      {% for code in i18n_locales %}
        <option value="{{ code }}">{{ code }}</option>
      {% endfor %}
    </select>

    <label class="k" for="variation" data-i18n="settings.number_format">Number Format</label>
    <select class="input" id="variation" data-variation-select>
      <option value="normal" data-i18n="settings.format_normal">Normal (1.23K)</option>
      <option value="short" data-i18n="settings.format_none">Nothing (1,234)</option>
      <option value="scientific" data-i18n="settings.format_scientific">Scientific (1.23e3)</option>
    </select>
  </div>
</article>

<article class="card section">
  <h2 class="section-title" data-i18n="settings.consent">Consent</h2>

  <div class="kv" style="gap:10px">
    <label class="input">
      <input type="checkbox" id="cookie-consent">
      <span data-i18n="cookie.details">I accept the use of cookies</span>
    </label>
  </div>
</article>

<article class="card section loading" id="privacySettings">
  <h2 class="section-title" data-i18n="privacy">Privacy</h2>

  <div class="privacy-presets" style="margin-bottom: 16px;">
    <div style="margin-bottom: 10px; font-weight: 800; font-size: 13px; color: var(--c-muted); text-transform: uppercase; letter-spacing: 0.05em;" data-i18n="privacy.presets">Presets</div>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <button class="btn-preset" data-preset="private" type="button" data-i18n="privacy.preset_private">Private</button>
      <button class="btn-preset" data-preset="balanced" type="button" data-i18n="privacy.preset_balanced">Balanced</button>
      <button class="btn-preset" data-preset="analytics" type="button" data-i18n="privacy.preset_analytics">Full Analytics</button>
    </div>
  </div>

  <div class="privacy-divider"></div>

  <div class="privacy-sections" id="privacySections">
  </div>
</article>

<article class="card section">
  <h2 class="section-title" data-i18n="settings.data_management">Data Management</h2>

  <div style="display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
    <button class="btn-danger-secondary" id="btnDeleteMessages" type="button" data-i18n="settings.delete_messages">
      Delete Messages
    </button>

    <button class="btn-danger-secondary" id="btnDeleteVoice" type="button" data-i18n="settings.delete_voice">
      Delete Voice Data
    </button>

    <button class="btn-danger-secondary" id="btnDeleteActivities" type="button" data-i18n="settings.delete_activities">
      Delete Activities
    </button>

    <button class="btn-danger-secondary" id="btnDeleteEconomy" type="button" data-i18n="settings.delete_economy">
      Delete Economy Data
    </button>

    <button class="btn-danger-secondary" id="btnDeleteAnalytics" type="button" data-i18n="settings.delete_analytics">
      Delete Analytics
    </button>
  </div>
</article>

<article class="card section section--danger">
  <h2 class="section-title section-title--danger" data-i18n="settings.danger_zone">Danger Zone</h2>

  <p style="color: var(--c-muted); margin: 0 0 12px; font-weight: 700; font-size: 14px;" data-i18n="settings.danger_desc">This action cannot be undone. All your data will be permanently deleted from our servers.</p>

  <button class="btn-danger" id="btnDeleteAllData" type="button" data-i18n="settings.delete_all_data">
    Delete All Data
  </button>
</article>

<template id="privacySectionTemplate">
  <div class="privacy-section">
    <h3 class="privacy-section__title" data-i18n=""></h3>

    <div class="privacy-flags">
    </div>
  </div>
</template>

<template id="privacyFlagTemplate">
  <label class="privacy-flag skeleton">
    <input type="checkbox" class="privacy-flag__input" data-flag="">
    <span class="privacy-flag__label" data-i18n=""></span>
  </label>
</template>
